# Copy to .env.local and fill in values from Supabase → Project Settings → API
#
# Use the "Project URL" and the "anon" "public" key (safe for browsers with RLS).
# Do NOT use the service_role key in the frontend.

REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Optional: separate backend API only if you use backend/server.js for something else
# REACT_APP_API_URL=http://localhost:4000
